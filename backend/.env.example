HOST=127.0.0.1
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/miyoushe.sqlite
# Generate 32 random bytes as base64; never commit your real key.
DATA_ENCRYPTION_KEY=
# Use an independent random token of at least 32 characters.
BOOTSTRAP_TOKEN=
# Exact origins, comma separated; no trailing slash or wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
UPSTREAM_TIMEOUT_MS=15000
