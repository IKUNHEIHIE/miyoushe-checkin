{
  "name": "miyoushe-backend",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "types:generate": "openapi-typescript ../docs/openapi.json -o src/api-types.d.ts",
    "backup": "node --env-file-if-exists=.env dist/src/backup.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.6.0",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "openapi-typescript": "^7.9.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
